<%- include('../partials/header') %>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= details.name %></h1>
            <p class="route-description"><%= details.description %></p>
            
            <% if (details.highlights && details.highlights.length > 0) { %>
            <div class="highlights">
                <% details.highlights.forEach(function(highlight) { %>
                <span class="highlight-tag"><%= highlight %></span>
                <% }); %>
            </div>
            <% } %>
        </div>
        
        <% if (details.imageUrl) { %>
        <div class="route-image">
            <img src="<%= details.imageUrl %>" alt="<%= details.name %>">
        </div>
        <% } %>
    </div>

    <div class="route-info">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Region</span>
                <span class="info-value region-<%= details.region %>"><%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Duration</span>
                <span class="info-value"><%= details.duration %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Distance</span>
                <span class="info-value"><%= details.distance %> km</span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Best Season</span>
                <span class="info-value season-<%= details.bestSeason %>"><%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %></span>
            </div>
        </div>

        <div class="route-stations">
            <h2>Trip</h2>
                <div class="stations">
                    <div class="station">
                    <span class="station-label">Start</span>
                        <div class="station-header">
                        <span class="station-name"><%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %></span>
                        <button type="button" class="station-info-btn" data-station-id="<%= details.startStation %>" aria-expanded="false">
                        Details
                        </button>
                        </div>
                        <div class="station-details" hidden></div>
                    </div>
                    <div class="station">
                    <span class="station-label">End</span>
                        <div class="station-header">
                        <span class="station-name"><%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %></span>
                        <button type="button" class="station-info-btn" data-station-id="<%= details.endStation %>" aria-expanded="false">
                        Details
                        </button>
                    </div>
                        <div class="station-details" hidden></div>
                    </div>
                </div>
        </div>

        <div class="route-operating">
            <h2>Operating Schedule</h2>
            <div class="months-grid">
                <% details.operatingMonths.forEach(function(month) { %>
                <span class="month-badge"><%= month %></span>
                <% }); %>
            </div>
        </div>

        <% if (details.schedules && details.schedules.length > 0) { %>
        <div class="route-schedules">
            <h2>Available Schedules</h2>
            <div class="schedules-grid">
                <% details.schedules.forEach(function(schedule) { %>
                <div class="schedule-card">
                    <div class="schedule-times">
                        <div class="time-block">
                            <span class="time-label">Departs</span>
                            <span class="time-value"><%= schedule.departureTime %></span>
                        </div>
                        <span class="time-arrow">→</span>
                        <div class="time-block">
                            <span class="time-label">Arrives</span>
                            <span class="time-value"><%= schedule.arrivalTime %></span>
                        </div>
                    </div>
                    <div class="schedule-days">
                        <% schedule.daysOfWeek.forEach(function(day) { %>
                        <span class="day-badge"><%= day.substring(0, 3) %></span>
                        <% }); %>
                    </div>
                    <a href="/trips/booking/<%= schedule.id %>" class="book-btn">Book Now</a>
                </div>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>
</article>
<script>
    document.querySelectorAll('.station-info-btn').forEach((button) => {
        button.addEventListener('click', async () => {
            const stationCard = button.closest('.station');
            const detailsBox = stationCard.querySelector('.station-details');
            const stationId = button.dataset.stationId;
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
                detailsBox.hidden = true;
                button.setAttribute('aria-expanded', 'false');
                return;
            }

            // if the details have already been loaded, just show them
            if (detailsBox.dataset.loaded === 'true') {
                detailsBox.hidden = false;
                button.setAttribute('aria-expanded', 'true');
                return;
            }

            detailsBox.hidden = false;
            detailsBox.textContent = 'Loading station details...';
            button.setAttribute('aria-expanded', 'true');

            try {
                const response = await fetch(`/api/stations/${encodeURIComponent(stationId)}`);
                if (!response.ok) {
                    throw new Error(`HTTP error ${response.status}`);
                }

                const station = await response.json();
                const facilitiesList = Array.isArray(station.facilities) && station.facilities.length > 0
                    ? station.facilities.map((f) => f.replace(/_/g, ' ')).join(', ')
                    : 'None listed';

                detailsBox.innerHTML = `
                    <p><strong>${station.name}</strong> (${station.prefecture}, ${station.region})</p>
                    <p>${station.description || ''}</p>
                    <p><strong>Facilities:</strong> ${facilitiesList}</p>
                `;
                detailsBox.dataset.loaded = 'true';
            } catch (error) {
                console.error('Error loading station details:', error);
                detailsBox.textContent = 'Unable to load station information.';
            }
        });
    });
</script>
<%- include('../partials/footer') %>