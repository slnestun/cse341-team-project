<%- include('../partials/header') %>

<section class="auth-page auth-page--register">
    <h1>Create an Account</h1>

    <% if (error) { %>
        <p role="alert"><%= error %></p>
    <% } %>

    <form action="/register" method="post">
        <label for="displayName">Display name</label>
        <input id="displayName" name="displayName" type="text" value="<%= form.displayName || '' %>" required autocomplete="name">

        <label for="username">Username</label>
        <input id="username" name="username" type="text" value="<%= form.username || '' %>" required autocomplete="username">

        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= form.email || '' %>" required autocomplete="email">

        <label for="password">Password</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password">

        <button type="submit">Register</button>
    </form>

    <p>Already have an account? <a href="/login">Log in</a>.</p>
</section>

<%- include('../partials/footer') %>
